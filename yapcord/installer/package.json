{
  "name": "yapcord-installer",
  "version": "0.1.0",
  "description": "Installer for Yapcord",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.yapcord.installer",
    "productName": "Yapcord Installer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "patcher.js",
      "index.html",
      "buildinfo.json",
      "bundle/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "YapcordInstaller.exe"
    }
  }
}